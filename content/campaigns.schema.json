{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gokuraku.tech/schema/campaigns.json",
  "title": "GOKURAKU campaigns",
  "description": "キャンペーン管理データ。ソースコードを変更せずに、このデータ（または将来の管理画面）からキャンペーンを追加・変更します。公開されるのは status=published かつ legal.status=approved かつ期間内のものだけです。",
  "type": "object",
  "required": [
    "campaigns"
  ],
  "properties": {
    "campaigns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "start",
          "end",
          "regions",
          "product_categories",
          "conditions",
          "benefit",
          "status",
          "legal"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
            "description": "キャンペーンID（英小文字・数字・ハイフン）"
          },
          "title": {
            "$ref": "#/$defs/i18nText",
            "description": "タイトル（言語別）"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "開始日時（ISO 8601、タイムゾーン付き。例 2026-12-01T00:00:00+07:00）"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "description": "終了日時"
          },
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
            },
            "description": "適用地域（ISO 3166。例 TH, TH-10）"
          },
          "product_categories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "flower",
                "preroll",
                "goods",
                "accessory",
                "other"
              ]
            },
            "description": "対象商品の分類"
          },
          "conditions": {
            "$ref": "#/$defs/i18nText",
            "description": "適用条件（例：20本まとめて取り置き）"
          },
          "benefit": {
            "type": "object",
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "enum": [
                  "price_discount",
                  "bundle_price",
                  "free_item",
                  "gift",
                  "info_only"
                ],
                "description": "特典の種類"
              },
              "text": {
                "$ref": "#/$defs/i18nText"
              }
            }
          },
          "involves_cannabis_incentive": {
            "type": "boolean",
            "description": "大麻製品の購入特典・値引き・無償提供を含むか。true の場合、法令確認が approved になるまで絶対に公開されません。"
          },
          "status": {
            "enum": [
              "draft",
              "scheduled",
              "published",
              "archived"
            ],
            "description": "公開・非公開ステータス"
          },
          "legal": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "not_started",
                  "in_review",
                  "approved",
                  "rejected"
                ],
                "description": "法令確認ステータス"
              },
              "reviewed_by": {
                "type": "string"
              },
              "reviewed_at": {
                "type": "string",
                "format": "date"
              },
              "jurisdiction_notes": {
                "type": "string",
                "description": "確認した法令・規制のメモ"
              }
            }
          },
          "cta_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  },
  "$defs": {
    "i18nText": {
      "type": "object",
      "required": [
        "ja"
      ],
      "properties": {
        "ja": {
          "type": "string"
        },
        "en": {
          "type": "string"
        },
        "th": {
          "type": "string"
        },
        "zh": {
          "type": "string"
        },
        "ko": {
          "type": "string"
        },
        "es": {
          "type": "string"
        },
        "pt": {
          "type": "string"
        },
        "ru": {
          "type": "string"
        },
        "vi": {
          "type": "string"
        },
        "my": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "言語別の文言。ja は必須、他の言語が無い場合は ja を表示します。"
    }
  }
}
